SPOONACULAR_API_KEY=your_spoonacular_api_key
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
# MongoDB Atlas connection string for accounts (Atlas → Connect → Drivers). Keep the real one in .env only.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.n6zmea2.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB=gather
# Optional: set if the server logs "querySrv ECONNREFUSED" (Node using a local DNS resolver that refuses SRV lookups).
# DNS_SERVERS=1.1.1.1,8.8.8.8
